<img src="assets/profile.jpg" alt="Profile photo of Mohammed" width="300"><!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Links and Images</title>
</head>
<body>
    <h1>My Profile</h1>
    <p>My name is Mohammed. I am learning HTML.</p>

    <img src="assets/profile.jpg"
         alt="Profile photo of Mohammed">

    <p>
        <a href="https://github.com/"
           target="_blank"
           rel="noopener noreferrer">
            Visit GitHub
        </a>
    </p>

    <p><a href="#contact">Go to Contact</a></p>

    <h2 id="contact">Contact</h2>
    <p>
        <a href="mailto:mohammed@example.com">
            Email Mohammed
        </a>
    </p>
</body>
</html>
